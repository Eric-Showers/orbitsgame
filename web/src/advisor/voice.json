      "priority": "ack",
      "text": [
        "I will round off our orbit at the safest high point. {dv} of delta-v, about {eta}. Confirm?"
      ]
    },
    "ap.propose.altitude": {
      "priority": "ack",
      "text": [
        "Two burns to a {alt} circular orbit: one to start the climb or drop, one to settle. {dv} in all, about {eta}. Confirm?"
      ]
    },
    "ap.propose.rendezvous": {
      "priority": "ack",
      "text": [
        "Target is {range} away. I will line up altitudes, adjust our orbital timing, and arrive {standoff} off its side. {dv} of delta-v, about {eta}. Confirm?"
      ]
    },
    "ap.propose.intercept": {
      "priority": "ack",
      "text": [
        "Closing to firing range, about {standoff} behind the target at matched speed. {dv} of delta-v, about {eta}. Confirm?"
      ]
    },
    "ap.propose.match-velocity": {
      "priority": "ack",
      "text": [
        "I will burn against our relative motion, {rel} to cancel. {dv} of delta-v. Confirm?"
      ]
    },
    "ap.propose.station-keep": {
      "priority": "ack",
      "text": [
        "I will hold station beside the target and cancel any drift, closing in if it strays past {hold}. Confirm?"
      ]
    },
    "ap.propose.evade": {
      "priority": "ack",
      "text": ["{count} inbound. I will burn across their line of sight. Confirm, Commander."]
    },
    "ap.propose.launch-missile": {
      "priority": "ack",
      "text": [
        "Target {range} out, closing at {relv}. Firing solution is good, flight time about {eta}. Confirm to fire?"
      ]
    },
    "ap.propose.drop-mine": {
      "priority": "ack",
      "text": ["A hostile will cross this orbit, {range} at its closest. Confirm to lay the mine?"]
    },
