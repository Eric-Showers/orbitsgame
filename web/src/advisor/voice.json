    "status.online": {
      "priority": "status",
      "text": ["{callsign} online. All systems nominal. The ship is yours, Commander."]
    },
    "hazard.impact": {
      "priority": "critical",
      "cooldown": 20,
      "text": [
        "Commander, this orbit intersects the surface. Impact in {t}. Recommend a prograde burn.",
        "Our periapsis is below ground. Contact in {t}. A prograde burn will lift it."
      ]
    },
    "hazard.impact_imminent": {
      "priority": "critical",
      "repeat": 12,
      "text": ["Impact in {t}. I need that burn, Commander.", "{t} to surface. Burn prograde now."]
    },
    "hazard.low_periapsis": {
      "priority": "warning",
      "cooldown": 30,
      "text": [
        "Periapsis {pe}. Lower than I like. Recommend a prograde burn at apoapsis.",
        "We will skim {pe} at periapsis. Advise raising it."
      ]
    },
    "threat.missile": {
      "priority": "critical",
      "repeat": 8,
      "text": [
        "Missile inbound. Range {range}, closing {closing}. Contact in {t}.",
        "Hostile missile has us. {range} and closing. Contact in {t}."
      ]
    },
    "threat.mine_active": {
      "priority": "critical",
      "repeat": 10,
      "text": ["A mine has woken and is hunting us. Range {range}."]
    },
    "threat.mine_near": {
      "priority": "warning",
      "cooldown": 30,
      "text": [
        "Dormant mine at {range}. I would not linger near its trigger radius.",
        "Mine on the scope, {range}. Still asleep. Let us keep it that way."
      ]
    },
    "fuel.low": {
      "priority": "warning",
      "cooldown": 60,
      "text": ["Fuel at {pct}. {dv} of delta-v in hand. Spend it carefully."]
    },
    "fuel.bingo": {
      "priority": "warning",
      "cooldown": 60,
      "text": ["Bingo fuel. {dv} remaining. I would keep enough to come home."]
    },
    "fuel.out": {
      "priority": "critical",
      "text": ["Tanks dry. We are ballistic now, Commander.", "Fuel exhausted. We ride this orbit."]
    },
    "damage.hull": {
      "priority": "warning",
      "cooldown": 4,
      "text": ["We are hit. Hull integrity {hp}.", "Hull damage. Integrity {hp}. Systems holding."]
    },
    "status.lost": {
      "priority": "critical",
      "text": ["Hull integrity failing. It has been an honour, Commander."]
    },
