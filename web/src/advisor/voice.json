      "priority": "ack",
      "text": ["Track released."]
    },
    "ack.fire-missile": {
      "priority": "ack",
      "text": ["Missile away.", "Bird away. Guidance nominal."]
    },
    "ack.fire-missile.no_target": {
      "priority": "ack",
      "text": ["No target designated. Holding fire."]
    },
    "ack.fire-missile.fail": {
      "priority": "ack",
